---
/*
  ─ Cartridge — the arcade's play control ─

  A post with a playable build renders one. The chassis is drawn,
  not boxed: ridged shoulders with screw dots, a chamfered shell,
  a label window, and a connector foot with contact fins — the
  parts that say "this plugs into something". Text rides over it in
  HTML so titles stay selectable and wrap on their own terms. Site
  furniture, not a hexpunk candidate; azure throughout, because
  brass is never interactive.
*/
import { iconFor } from "../lib/icons";

interface Props {
  href: string;
  title: string;
  icon: string | null;
  collection: string;
  /** ISO date; the label formats it. */
  date: string;
  words: number;
  description: string;
}
const { href, title, icon, collection, date, words, description } = Astro.props;
const glyph = iconFor(collection, icon ?? undefined);
/* Below the width where the metadata rides the book's edge, the
   cartridge is the only header a playable post gets — so it carries
   what the panel keeps, labelled and one stat to a row. Dates read
   YYYY/MM/DD here as everywhere the journal shows one. */
const stats = [
  { label: "date", value: date.replaceAll("-", "/") },
  { label: "time", value: `~ ${Math.max(1, Math.round(words / 220))} min` },
];

/** Contact fins along the connector foot — the PCB edge. */
const FINS = Array.from({ length: 13 }, (_, i) => 68 + i * 10);
/** Ridge blocks on each shoulder grip. */
const RIDGES = [0, 1, 2, 3, 4];
---

<span class="journal-cartridge-slot">
  <a class="journal-cartridge" href={href} target="_blank" rel="noopener noreferrer">
  <svg class="journal-cartridge__chassis" viewBox="0 0 260 162" aria-hidden="true">
    {
      [0, 226].map((sx) => (
        <g>
          <rect class="shoulder" x={sx} y="14" width="34" height="122" />
          {RIDGES.map((i) => (
            <rect class="ridge" x={sx + 5} y={30 + i * 20} width="24" height="12" />
          ))}
          <circle class="screw" cx={sx + 17} cy="22" r="3" />
          <circle class="screw" cx={sx + 17} cy="128" r="3" />
        </g>
      ))
    }

    <path class="foot" d="M 62 132 H 198 V 158 H 62 Z" />

    {/* One silhouette for shell AND connector foot, so the outline
        wraps the contacts instead of cutting a line above them. */}
    <path class="shell" d="M 26 0 H 220 L 234 14 V 132 H 198 V 158 H 62 V 132 H 26 Z" />
    {FINS.map((x) => <rect class="fin" x={x} y="138" width="6" height="14" />)}
    <rect class="window" x="40" y="14" width="180" height="84" />
    <path class="sweep" d="M 40 72 L 101 44 L 220 52" />
    <path class="sweep sweep--faint" d="M 40 80 L 101 52 L 220 60" />
    <rect class="lip" x="40" y="106" width="180" height="26" />
  </svg>

    {/* One positioned box over the label window, flowing inside:
        a title beside its glyph, then the stats. Flow, not four
        absolute placements — a title that wraps to two lines has to
        push the stats down rather than land on top of them. */}
    <span class="journal-cartridge__label">
      <span class="journal-cartridge__head">
        <span class="journal-cartridge__glyph" set:html={glyph} />
        <span class="journal-cartridge__title">{title}</span>
      </span>
      <span class="journal-cartridge__stats">
        {
          stats.map((s) => (
            <span>
              <i>{s.label}</i>
              {s.value}
            </span>
          ))
        }
      </span>
    </span>
    <span class="journal-cartridge__play">play<i>↗</i></span>
  </a>
  <span class="journal-cartridge__blurb">{description}</span>
</span>
