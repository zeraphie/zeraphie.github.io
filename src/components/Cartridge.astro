---
/*
  ─ Cartridge — the arcade's play control ─

  A post with a playable build renders one: the SNES silhouette in
  the house language — ridged shoulders, a label window, and the
  connector lip carrying the call to action, so the affordance sits
  where the slot would take it. Site furniture, not a hexpunk
  candidate; azure throughout, because brass is never interactive.
*/
import { iconFor } from "../lib/icons";

interface Props {
  href: string;
  title: string;
  icon: string | null;
  collection: string;
}
const { href, title, icon, collection } = Astro.props;
const glyph = iconFor(collection, icon ?? undefined);
---

<a class="journal-cartridge" href={href} target="_blank" rel="noopener noreferrer">
  <span class="journal-cartridge__shell">
    <span class="journal-cartridge__label">
      <span class="journal-cartridge__glyph" set:html={glyph} />
      <span class="journal-cartridge__title">{title}</span>
    </span>
    <span class="journal-cartridge__lip">play<i class="journal-cartridge__out">↗</i></span>
  </span>
</a>
