---
/**
 * ─ Seo — the head every route shares ─
 *
 * Canonical, Open Graph, Twitter, and JSON-LD, all derived from the
 * route's own metadata: a post carries its collection and date as
 * article properties, everything else is a plain page. The 2017
 * head's dead weight (a Facebook admin id, an 18-file touch-icon
 * set, classic analytics) is deliberately not carried over.
 */
interface Props {
  title: string;
  description: string;
  /** Posts are articles; the world, collections, and documents are pages. */
  article?: { section: string; published: string; modified?: string };
}
const { title, description, article } = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\/+$/, "") || "/", Astro.site).href;
const type = article ? "article" : "website";

const schema = article
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: title,
      description,
      articleSection: article.section,
      datePublished: article.published,
      dateModified: article.modified ?? article.published,
      author: { "@type": "Person", name: "Izzy", url: Astro.site?.href },
      mainEntityOfPage: canonical,
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "izelya.me",
      description,
      url: Astro.site?.href,
    };
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="izelya.me" />
<meta property="og:locale" content="en_GB" />
{
  article && (
    <>
      <meta property="article:section" content={article.section} />
      <meta property="article:published_time" content={article.published} />
      <meta property="article:author" content="Izzy" />
    </>
  )
}

<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

<meta name="author" content="Izzy" />
<meta name="theme-color" content="#0f1113" />
<!-- The invader from the 2017 site, carried over deliberately: it is
  the mark people recognise in a tab. Declared image/png because that
  is what the bytes are — the old repo named a 32x32 PNG `.ico`. -->
<link rel="icon" type="image/png" href="/favicon.png" />

<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
