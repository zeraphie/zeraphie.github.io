---
/*
  ─ izelya.me — THE FLOW ─

  The homepage IS an hp-grid world, route-driven: arrival is one
  viewport-filling hex with hp-background ignition crawling off
  it; hover blooms the sections (hp-unfold-list); a section flies
  down a directed hp-tether to its far-away category, revealed as
  a honeycomb hp-cluster; an item dives into the reading layer
  with hp-hextrack as the sibling + anchor rail. Every state is a
  hash URL; deep links restore instantly, in-session moves
  animate. The longform reading vessel is still under design —
  the deep hex here is the standing baseline, not a decision.
*/
import "@hexpunk/core/tokens.dark.css";
import "@hexpunk/core/tokens.light.css";
import "@hexpunk/core/elements.css";

const SIDE = (100 - 2.5) / Math.sqrt(3);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>izelya.me</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/fonts/fonts.css" />
  </head>
  <body>
    <hp-background id="bg" page hex-size={SIDE.toFixed(2)}></hp-background>

    <div id="hs-stage">
      <hp-grid id="world" draggable>
        <hp-unfold-list id="seed-unfold" unordered hover q="0" r="0" draggable="false">
          <hp-cell variant="anchor" filled slot="source" id="seed-cell">izelya</hp-cell>
          <hp-cell class="section" data-cluster="projects" variant="action">projects</hp-cell>
          <hp-cell class="section" data-cluster="arcade" variant="action">arcade</hp-cell>
          <hp-cell class="section" data-cluster="writing" variant="action">writing</hp-cell>
          <hp-cell class="section" data-cluster="about" variant="action">about</hp-cell>
        </hp-unfold-list>
      </hp-grid>

      <div class="hs-status"><span id="hs-path">~/</span></div>
      <div class="hs-hint" id="hs-hint">the hex is listening</div>
      <button type="button" class="hs-reset" id="hs-reset">↺ reset world</button>

      <!-- The dived page: once the camera lands in a cell, the world
           fades out beneath this layer and reading happens at real
           pixel scale. Each dived hex is a CARD; sibling navigation
           slides cards horizontally — transform-only, no camera. -->
      <div class="page" id="page"></div>

      <hp-hextrack id="track" hidden></hp-hextrack>
    </div>

    <style is:global>
      html,
      body {
        margin: 0;
        height: 100%;
        background: var(--hp-background);
        color: var(--hp-on-surface);
        font-family: "Chakra Petch", Inter, ui-sans-serif, system-ui, sans-serif;
        overflow: hidden;
      }

      /* Backdrop: ignition + wake. elements.css gives html its own
         background, which stops body-background propagation — and a
         non-propagated body background paints OVER negative-z fixed
         children, burying the default z:-1. Lift to 0; everything
         above it in the stage is transparent where it matters. */
      #bg {
        --hp-bg-z: 0;
        --hp-bg-faint-opacity: 0;
        --hp-bg-bright-opacity: 0.55;
        --hp-bg-hot-opacity: 0.95;
        transition: opacity 550ms ease;
      }
      #bg.calm {
        opacity: 0;
      }
      /* Page view: a faint base lattice is always there around the
         reading hex, so the ambience is visible before the pointer
         ever moves; the wake rides on top of it. */
      #bg.ambient {
        --hp-bg-faint-opacity: 0.16;
      }

      /* Arrival curtain: the stage reveals only after the camera has
         been placed, so the first painted frame IS the framed seed. */
      #hs-stage {
        position: relative;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        opacity: 0;
        transition: opacity 320ms ease;
      }
      #hs-stage.live {
        opacity: 1;
      }
      #world {
        position: absolute;
        inset: 0;
        display: block;
        /* Contain the cells' hover/drag z-lifts: without an isolated
           stacking context, a hovered cell's layer token out-stacks
           the page overlay — and, sitting on top, keeps the pointer
           and sustains its own hover. */
        isolation: isolate;
      }

      .hs-status {
        position: absolute;
        top: 1rem;
        left: 1.25rem;
        z-index: 3;
        font-size: 0.8rem;
        letter-spacing: 0.14em;
        text-transform: lowercase;
        color: var(--hp-on-surface-variant);
        pointer-events: none;
      }
      .hs-status b {
        color: var(--hp-secondary);
        font-weight: 400;
      }
      .hs-hint {
        position: absolute;
        left: 50%;
        bottom: 7vh;
        transform: translateX(-50%);
        z-index: 3;
        font-size: 0.72rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--hp-on-surface-variant);
        opacity: 0.65;
        pointer-events: none;
        transition: opacity 400ms ease;
      }
      .hs-hint[data-gone] {
        opacity: 0;
      }
      .hs-reset {
        position: absolute;
        top: 0.9rem;
        right: 0.9rem;
        z-index: 3;
        font: inherit;
        font-size: 0.7rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        padding: 0.35rem 0.7rem;
        background: var(--hp-surface-container);
        color: var(--hp-on-surface-variant);
        border: 1px solid var(--hp-outline-variant);
        cursor: pointer;
        opacity: 0.5;
      }
      .hs-reset:hover {
        opacity: 1;
        color: var(--hp-secondary);
      }

      /* ── cluster reveal (page-side choreography, flagged for
            absorption into hp-cluster) ── */
      hp-cluster .hx-reveal {
        opacity: 0;
        scale: 0.25;
        transition:
          scale 340ms cubic-bezier(0.2, 1.35, 0.35, 1),
          opacity 240ms ease;
        transition-delay: var(--d, 0ms);
      }
      hp-cluster .hx-on {
        opacity: 1;
        scale: 1;
      }
      hp-cluster.hx-closing .hx-reveal {
        opacity: 0;
        scale: 0.25;
      }
      .hx-denied {
        animation: hx-deny 480ms ease;
      }
      @keyframes hx-deny {
        30% {
          filter: drop-shadow(0 0 8px var(--hp-warn));
        }
      }

      /* ── the dived page layer ──
         Once the camera lands in a cell, the whole world fades out
         beneath this screen-space frame: a crisp hex at real pixel
         scale whose middle band (between the shoulder vertices)
         holds a standard scrollable main. Typography is the design
         system's own prose rhythm — no world scaling anywhere. */
      .page {
        position: absolute;
        inset: 0;
        z-index: 2;
        display: grid;
        place-items: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity 260ms ease;
        /* Transparent: the world beneath is visibility-hidden while
           reading, and hp-background's wake shows around the hex to
           keep the page ambient and alive. */
        background: transparent;
      }
      .page[data-open] {
        opacity: 1;
        pointer-events: auto;
      }
      /* One dived hex = one card. Sibling moves slide whole cards —
         transform + opacity only, so the compositor owns the motion. */
      .page-card {
        position: absolute;
        inset: 0;
        will-change: transform;
        transition:
          transform 460ms cubic-bezier(0.3, 0.9, 0.25, 1),
          opacity 460ms ease;
      }
      body[data-perf="low"] .page-card {
        transition: none;
      }
      /* Deep-dive framing: the hex's straight sides hug the viewport
         sides; the points run off-screen. The reading pane takes the
         middle band, clamped to the viewport on wide screens. */
      .page-hex {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 94vw;
        aspect-ratio: 0.866 / 1;
        clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
        background: var(--hp-outline);
      }
      .page-hex-in {
        position: absolute;
        inset: 2px;
        clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
        /* Translucent: the ambient field ghosts through the reading
           surface, muted relative to the open field outside. */
        background: color-mix(in srgb, var(--hp-surface-container-lowest) 91%, transparent);
      }
      .page-meta {
        position: absolute;
        top: 1.4rem;
        left: 0;
        right: 0;
        text-align: center;
        font-size: 0.72rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--hp-secondary);
        pointer-events: none;
      }
      .page-main {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: min(74ch, calc(94vw - 9rem));
        height: min(51vw, calc(100vh - 9rem));
        overflow-y: auto;
        overflow-x: hidden;
        padding-right: 0.9rem;
        overscroll-behavior: contain;
        scrollbar-width: thin;
        scrollbar-color: var(--hp-outline-variant) transparent;
      }
      .page-main::-webkit-scrollbar {
        width: 6px;
      }
      .page-main::-webkit-scrollbar-thumb {
        background: var(--hp-outline-variant);
      }
      .page-foot {
        position: absolute;
        bottom: 1.1rem;
        left: 0;
        right: 0;
        text-align: center;
        font-size: 0.66rem;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--hp-on-surface-variant);
        opacity: 0.7;
        pointer-events: none;
      }
      hp-hextrack {
        z-index: 3;
      }

      /* Software-compositor degrade: every layer is CPU-composited,
         so drop the second GL sim and the long full-viewport fades. */
      body[data-perf="low"] #bg {
        display: none;
      }
      body[data-perf="low"] .page,
      body[data-perf="low"] #hs-stage,
      body[data-perf="low"] hp-cluster .hx-reveal {
        transition: none;
      }

      @media (prefers-reduced-motion: reduce) {
        hp-cluster .hx-reveal,
        #bg,
        #hs-stage {
          transition: none;
        }
      }
    </style>

    <script>
      import "@hexpunk/core";
      import "@hexpunk/core/wip";
      import {
        axialToWorld,
        hexHeight,
        hexWidth,
        seamlessSide,
        type AxialCoord,
        type HpGrid,
      } from "@hexpunk/core/grid";
      import type { HpBackground } from "@hexpunk/core";
      import type {
        HpHextrack,
        HpHextrackActivateDetail,
        HpHextrackSubDetail,
        HpUnfoldList,
      } from "@hexpunk/core/wip";

      /* Software WebGL means every frame of every canvas is CPU
       * work — detect it once, degrade honestly, and say so in the
       * console so "is it my hardware acceleration?" has an answer. */
      function softwareRendered(): boolean {
        try {
          const probe = document.createElement("canvas");
          const gl = probe.getContext("webgl2") ?? probe.getContext("webgl");
          if (!gl) {
            return true;
          }
          const info = gl.getExtension("WEBGL_debug_renderer_info");
          const renderer = info
            ? String(gl.getParameter(info.UNMASKED_RENDERER_WEBGL))
            : "";
          console.info(
            `[flow] webgl renderer: ${renderer || "(masked)"} — ` +
              "if this says SwiftShader/Software, browser hardware acceleration is off " +
              "(chrome://gpu, Settings → System → graphics acceleration)"
          );
          return /swiftshader|software|llvmpipe|basic render/i.test(renderer);
        } catch {
          return true;
        }
      }
      // Manual override for A/B-ing the degrade: ?perf=low or
      // localStorage flow-perf=low forces it on real hardware.
      const PERF_FORCED =
        new URLSearchParams(location.search).get("perf") === "low" ||
        (() => {
          try {
            return localStorage.getItem("flow-perf") === "low";
          } catch {
            return false;
          }
        })();
      const PERF_LOW = PERF_FORCED || softwareRendered();
      if (PERF_LOW) {
        document.body.dataset.perf = "low";
        console.info(
          `[flow] degrade active (${PERF_FORCED ? "forced" : "software gpu detected"})`
        );
      }

      const PAD = 64;
      /** Category distance from the seed along its fan direction —
       * far enough that fully-expanded neighbours never touch. */
      const D = 14;
      const LEASH_CLUSTER = 3;

      const stage = document.getElementById("hs-stage")!;
      const world = document.getElementById("world") as HpGrid;
      const bg = document.getElementById("bg") as HpBackground;
      const track = document.getElementById("track") as HpHextrack;
      const seedUnfold = document.getElementById("seed-unfold") as HpUnfoldList;
      const seedCell = document.getElementById("seed-cell")!;
      const pathEl = document.getElementById("hs-path")!;
      const hintEl = document.getElementById("hs-hint")!;

      const side = seamlessSide(100, 2.5);
      const cellW = hexWidth(side);
      const cellH = hexHeight(side);

      /* hp-unfold-list's ring slots, by data-unfold-index. */
      const SLOT_DIR: AxialCoord[] = [
        { q: 0, r: -1 },
        { q: 1, r: -1 },
        { q: 1, r: 0 },
        { q: 0, r: 1 },
        { q: -1, r: 1 },
        { q: -1, r: 0 },
      ];
      /* hp-cluster honeycomb fill order, centre first. */
      const HONEY: AxialCoord[] = [
        { q: 0, r: 0 },
        { q: 0, r: -1 },
        { q: 1, r: -1 },
        { q: 1, r: 0 },
        { q: 0, r: 1 },
        { q: -1, r: 1 },
        { q: -1, r: 0 },
        { q: 0, r: -2 },
        { q: 1, r: -2 },
      ];

      // ── content ──
      interface Item {
        id: string;
        label: string;
        sub: string;
        lead: string;
        url: string;
        subs: string[];
        ghost?: boolean;
      }
      interface Cluster {
        id: string;
        label: string;
        key: string;
        items: Item[];
        cell?: AxialCoord;
      }
      const g = (id: string, label: string, sub: string): Item => ({
        id,
        label,
        sub,
        lead: "",
        url: "",
        subs: [],
        ghost: true,
      });
      const CLUSTERS: Cluster[] = [
        {
          id: "projects",
          label: "projects",
          key: "1",
          items: [
            { id: "hexpunk", label: "hexpunk", sub: "design system", lead: "Wireframe-cyberpunk Lit components — the system this very site is built from. Hexagonal-first, honest geometry, tokens all the way down.", url: "/projects/hexpunk", subs: ["overview", "elements", "changelog"] },
            { id: "snecko", label: "snecko", sub: "game", lead: "A browser snake with opinions. Playable in the arcade, embedded from its own deployment.", url: "/projects/snecko", subs: ["about", "play in arcade"] },
            { id: "wok", label: "warrior of keyboard", sub: "game", lead: "A keyboard battle game. Bring your fastest fingers and a mechanical conscience.", url: "/projects/warrior-of-keyboard", subs: ["about", "play in arcade"] },
            { id: "ddf", label: "discord dates", sub: "tool", lead: "A timestamp formatter for Discord messages — paste a time, get every format Discord understands.", url: "/projects/discord-date-formatter", subs: ["about", "formats"] },
            g("questboard", "questboard", "soon"),
            g("vtt", "vtt", "soon"),
          ],
        },
        {
          id: "arcade",
          label: "arcade",
          key: "2",
          items: [
            { id: "cart-snecko", label: "snecko", sub: "insert cart", lead: "Boot the snake. High scores are local and sacred.", url: "/arcade/snecko", subs: ["insert coin", "high scores"] },
            { id: "cart-wok", label: "warrior of keyboard", sub: "insert cart", lead: "Boot the battle. The cartridge-insert animation is a real loading screen.", url: "/arcade/warrior-of-keyboard", subs: ["insert coin", "high scores"] },
            g("freeplay", "free play", "no coins"),
          ],
        },
        {
          id: "writing",
          label: "writing",
          key: "3",
          items: [
            { id: "aetherblade", label: "aetherblade", sub: "d&d · class", lead: "A full homebrew class, fifteen-column table of legend included. The hardest rendering test this site owns.", url: "/dnd/aetherblade", subs: ["the class", "subclass paths", "balance notes"] },
            { id: "sanguine", label: "sanguine pact", sub: "d&d", lead: "Blood-priced power, notarised. A warlock pact for tables that read the fine print.", url: "/dnd/sanguine-pact", subs: ["the pact", "invocations"] },
            { id: "nihility", label: "oath of nihility", sub: "d&d", lead: "A paladin oath sworn to the void, for players who keep their promises to nothing.", url: "/dnd/oath-of-nihility", subs: ["tenets", "oath spells"] },
            { id: "merlin", label: "merlin's claw", sub: "d&d", lead: "An artefact with opinions about who wields it.", url: "/dnd/merlins-claw", subs: ["the artefact", "attunement"] },
            { id: "homerules", label: "my home rules", sub: "d&d · rules", lead: "The table law. Argue with the DM, lose gracefully.", url: "/dnd/my-home-rules", subs: ["table law", "variants"] },
            { id: "post-ddf", label: "discord dates", sub: "dev log", lead: "Building the timestamp formatter, and what Discord's format tokens taught me.", url: "/posts/discord-dates", subs: ["write-up", "source"] },
            { id: "post-pjax", label: "pjax", sub: "dev log", lead: "Instant navigation, 2017 edition — the ancestor of everything this site does with a camera.", url: "/posts/pjax", subs: ["write-up", "source"] },
            { id: "post-pwgen", label: "passwordgen", sub: "dev log", lead: "Small tool, strong strings.", url: "/posts/passwordgen", subs: ["write-up", "source"] },
          ],
        },
        {
          id: "about",
          label: "about",
          key: "4",
          items: [
            { id: "me", label: "about me", sub: "who i am", lead: "Izzy. Builds hexagons, games, and homebrew. This site is the proof.", url: "/about", subs: ["bio", "contact"] },
            { id: "github", label: "github", sub: "zeraphie", lead: "Where the source lives — every project on this site, in the open.", url: "https://github.com/zeraphie", subs: ["profile"] },
            { id: "oldsite", label: "the archive", sub: "old site", lead: "zeraphie.github.io, frozen with honour. The 2017 blog this world replaced.", url: "https://zeraphie.github.io", subs: ["visit the archive"] },
          ],
        },
      ];

      const slug = (s: string) => s.replaceAll(" ", "-");
      const axialDistance = (a: AxialCoord, b: AxialCoord): number => {
        const dq = a.q - b.q;
        const dr = a.r - b.r;
        return (Math.abs(dq) + Math.abs(dr) + Math.abs(dq + dr)) / 2;
      };

      // ── framing math (viewport-derived each time) ──
      const vh = () => stage.clientHeight;
      /** Arrival: the seed hex fills the viewport height minus equal
       * padding above and below. */
      const zSeed = () => (vh() - 2 * PAD) / cellH;
      /** Bloomed: seed + its ring framed the same way. */
      const zBloom = () => (vh() - 2 * PAD) / (cellH + 3 * side);
      /** A category cluster (ring 2) framed the same way. */
      const zCluster = () => (vh() - 2 * PAD) / (cellH + 6 * side);

      // ── prose face generation ──
      // ── the dived page layer: cards on an opaque backdrop ──
      const page = document.getElementById("page")!;
      const REDUCED = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let pageTimer = 0;
      let worldHideTimer = 0;
      let currentCard: HTMLElement | null = null;
      let currentMain: HTMLElement | null = null;
      let current: Route = {};

      function pageHtml(item: Item): string {
        const sections = item.subs
          .map(
            (s) => `
        <h2 id="h-${slug(s)}">${s}</h2>
        <p>${item.lead} This section stands in for the real ${s} content — a standard page in the hex's middle band, set in the system's own prose rhythm.</p>
        <p>[placeholder — your ${s} voice goes here. The geometry is honest; the words are not yet.]</p>`
          )
          .join("");
        return `<h1>${item.label}</h1><p><em>${item.sub}</em> — ${item.lead}</p>${sections}`;
      }

      function buildCard(item: Item): HTMLElement {
        const card = document.createElement("div");
        card.className = "page-card";
        card.innerHTML = `<div class="page-hex"><div class="page-hex-in"></div></div>
          <div class="page-meta">izelya.me ${item.url}</div>
          <main class="hp-prose page-main">${pageHtml(item)}</main>
          <div class="page-foot">esc surfaces · the track waits at the right edge</div>`;
        return card;
      }

      function adoptCard(card: HTMLElement): void {
        currentCard = card;
        currentMain = card.querySelector<HTMLElement>(".page-main");
      }

      /** Post-open bookkeeping shared by the fade-in and slide paths:
       * retire the world, watchdog the backdrop fade, land anchors. */
      function settleOpen(head: string | undefined, instant: boolean): void {
        window.clearTimeout(worldHideTimer);
        worldHideTimer = window.setTimeout(
          () => {
            world.style.visibility = "hidden";
          },
          instant ? 0 : 340
        );
        window.setTimeout(() => {
          if (page.hasAttribute("data-open") && Number(getComputedStyle(page).opacity) < 1) {
            console.warn("[flow] page fade stranded — forcing completion");
            page.style.opacity = "1";
          }
        }, 700);
        if (head) {
          scrollMain(head, !instant);
          // Late webfonts reflow the prose and shift anchors —
          // re-land on the heading once faces settle.
          void document.fonts.ready.then(() => {
            if (page.hasAttribute("data-open") && current.head === head) {
              scrollMain(head, false);
            }
          });
        } else if (currentMain) {
          currentMain.scrollTop = 0;
        }
      }

      function openPage(item: Item, head: string | undefined, instant: boolean): void {
        window.clearTimeout(pageTimer);
        const card = buildCard(item);
        page.replaceChildren(card);
        adoptCard(card);
        const show = () => {
          page.dataset.open = "";
          settleOpen(head, instant);
        };
        if (instant) {
          show();
        } else {
          // Start the fade while the camera is still flying — no
          // still frame of the world's frozen hover ever shows.
          pageTimer = window.setTimeout(show, 240);
        }
      }

      /** Sibling navigation: whole cards slide horizontally, the
       * direction taken from track order — a target ABOVE the
       * current item enters from the left, BELOW from the right.
       * Transform-only, synchronous start→reflow→end so the
       * transition arms without an animation frame; the camera and
       * the hidden world are never involved. */
      function slideToPage(item: Item, head: string | undefined, dir: number): void {
        const oldCard = currentCard;
        const next = buildCard(item);
        const skip = PERF_LOW || REDUCED;
        if (!skip) {
          next.style.transform = `translateX(${dir * 100}vw)`;
        }
        page.appendChild(next);
        adoptCard(next);
        if (skip) {
          oldCard?.remove();
        } else {
          next.getBoundingClientRect();
          next.style.transform = "translateX(0)";
          if (oldCard) {
            oldCard.style.transform = `translateX(${-dir * 100}vw)`;
            oldCard.style.opacity = "0.35";
            window.setTimeout(() => oldCard.remove(), 520);
          }
        }
        settleOpen(head, true);
      }

      function closePage(): void {
        window.clearTimeout(pageTimer);
        window.clearTimeout(worldHideTimer);
        delete page.dataset.open;
        page.style.opacity = "";
        world.style.visibility = "";
        world.style.pointerEvents = "";
        bg.style.display = "";
        window.setTimeout(() => {
          if (!page.hasAttribute("data-open")) {
            page.replaceChildren();
            currentCard = null;
            currentMain = null;
          }
        }, 320);
      }

      function scrollMain(head: string, smooth: boolean): void {
        const target = currentMain?.querySelector<HTMLElement>(`#h-${CSS.escape(head)}`);
        if (currentMain && target) {
          currentMain.scrollTo({
            top: Math.max(0, target.offsetTop - 8),
            behavior: smooth ? "smooth" : "auto",
          });
        }
      }

      // ── cluster build / mount ──
      const clusterOffsets = new Map<string, AxialCoord>();
      let mounted: { cluster: Cluster; el: HTMLElement; vein: HTMLElement } | null = null;

      function buildCluster(cluster: Cluster, animate: boolean): HTMLElement {
        const el = document.createElement("hp-cluster");
        el.setAttribute("layout", "honeycomb");
        el.id = `cluster-${cluster.id}`;
        el.setAttribute("drag-handle", ":first-child");
        const off = clusterOffsets.get(cluster.id) ?? { q: 0, r: 0 };
        el.setAttribute("q", String(cluster.cell!.q + off.q));
        el.setAttribute("r", String(cluster.cell!.r + off.r));

        const centre = document.createElement("hp-cell");
        centre.setAttribute("variant", "anchor");
        centre.textContent = cluster.label;
        el.appendChild(centre);

        cluster.items.forEach((item, i) => {
          const cell = document.createElement("hp-cell");
          cell.setAttribute("variant", item.ghost ? "slot" : "secondary");
          cell.className = item.ghost ? "hx-ghost" : "hx-item";
          cell.dataset.item = item.id;
          cell.dataset.slot = String(i + 1);
          if (!item.ghost) {
            cell.setAttribute("tabindex", "0");
          }
          cell.innerHTML = `<span class="hx-label">${item.label}</span>`;
          el.appendChild(cell);
        });

        if (animate) {
          let delay = 0;
          for (const child of Array.from(el.children) as HTMLElement[]) {
            child.classList.add("hx-reveal");
            child.style.setProperty("--d", `${delay}ms`);
            delay += 55;
          }
        }
        return el;
      }

      function mountCluster(cluster: Cluster, animate: boolean): void {
        if (mounted?.cluster.id === cluster.id) {
          return;
        }
        unmountCluster(false);
        const el = buildCluster(cluster, animate);
        world.appendChild(el);
        if (animate) {
          requestAnimationFrame(() =>
            requestAnimationFrame(() => {
              for (const child of Array.from(el.children)) {
                child.classList.add("hx-on");
              }
            })
          );
        } else {
          for (const child of Array.from(el.children)) {
            child.classList.add("hx-on");
          }
        }
        const vein = document.createElement("hp-tether");
        vein.setAttribute("from", "#seed-unfold");
        vein.setAttribute("to", `#cluster-${cluster.id}`);
        vein.setAttribute("directed", "");
        world.appendChild(vein);
        window.setTimeout(() => vein.setAttribute("state", "idle"), 1600);
        mounted = { cluster, el, vein };
      }

      /** Closing is the reveal in reverse; the elements leave after
       * the recede plays. */
      function unmountCluster(animate: boolean): void {
        if (!mounted) {
          return;
        }
        const { el, vein } = mounted;
        mounted = null;
        vein.remove();
        if (!animate) {
          el.remove();
          return;
        }
        el.classList.add("hx-closing");
        window.setTimeout(() => el.remove(), 420);
      }

      // ── router: the hash is the state ──
      type Route = { cat?: string; item?: string; head?: string };
      function parseRoute(): Route {
        const parts = location.hash.replace(/^#\/?/, "").split("/").filter(Boolean);
        return { cat: parts[0], item: parts[1], head: parts[2] };
      }
      function go(path: string): void {
        location.hash = path;
      }
      let suppressSurfaceSync = false;

      function clusterById(id?: string): Cluster | undefined {
        return CLUSTERS.find((c) => c.id === id);
      }

      function setPath(route: Route): void {
        const p = ["~", route.cat, route.item].filter(Boolean).join("/");
        pathEl.innerHTML = `~<b>${p.slice(1)}</b>${route.head ? `<span>#${route.head}</span>` : ""}`;
      }

      /** Dive framing that fits the whole hex on screen: the engine
       * fits a rect's WIDTH, so hand it an effective width whose fit
       * lands the zoom at (viewport height − padding) / hex height.
       * On viewports too narrow for that, the real width wins. */
      function diveRect(cell: HTMLElement): { cx: number; cy: number; w: number; h: number } {
        const slot = Number(cell.dataset.slot);
        const el = mounted!.el;
        const q = Number(el.getAttribute("q")) + (HONEY[slot]?.q ?? 0);
        const r = Number(el.getAttribute("r")) + (HONEY[slot]?.r ?? 0);
        const [cx, cy] = axialToWorld(q, r, side);
        const zFit = (vh() - 2 * 24) / cellH;
        const wEff = (stage.clientWidth * 0.94) / zFit;
        return { cx, cy, w: Math.max(cellW, wEff), h: cellH };
      }


      function applyRoute(route: Route, animated: boolean): void {
        const cluster = clusterById(route.cat);
        const prevDived = world.dived;

        // page + hextrack bookkeeping first
        if (!route.item && current.item) {
          closePage();
          track.state = "hint";
          track.hidden = true;
        }

        if (!cluster) {
          // home
          unmountCluster(animated);
          if (prevDived) {
            suppressSurfaceSync = true;
            world.surface();
          }
          const zoom = seedUnfold.open ? zBloom() : zSeed();
          if (animated) {
            world.flyTo({ q: 0, r: 0 }, zoom);
          } else {
            world.jumpTo({ q: 0, r: 0 }, zoom);
          }
          current = {};
          setPath(current);
          syncCalm();
          return;
        }

        // a category is in view — the fan is part of that view
        seedUnfold.open = true;
        mountCluster(cluster, animated && !prevDived);
        const clusterEl = mounted!.el;

        if (!route.item) {
          if (prevDived) {
            suppressSurfaceSync = true;
            world.surface();
          }
          if (animated) {
            world.flyTo(clusterEl, zCluster());
          } else {
            world.jumpTo(clusterEl, zCluster());
          }
          current = { cat: cluster.id };
          setPath(current);
          syncCalm();
          return;
        }

        const item = cluster.items.find((entry) => entry.id === route.item && !entry.ghost);
        if (!item) {
          go(`/${cluster.id}`);
          return;
        }
        const cell = clusterEl.querySelector<HTMLElement>(`[data-item="${item.id}"]`)!;

        const performDive = (instant: boolean) => {
          // The world goes pointer-dead the moment the dive starts:
          // nothing beneath the incoming page may hover or re-light
          // while the camera is mid-flight.
          world.style.pointerEvents = "none";
          world.diveInto(diveRect(cell), { instant });
          track.items = cluster.items.map((entry) => ({
            id: entry.id,
            label: entry.label,
            sub: entry.sub,
            ghost: entry.ghost,
            subs: entry.subs,
          }));
          track.focal = item.id;
          track.state = "hint";
          track.hidden = false;
          current = { cat: cluster.id, item: item.id, head: route.head };
          setPath(current);
          syncCalm();
          openPage(item, route.head, instant);
        };

        if (!animated) {
          // Deep link: place the pre-dive camera at the category view
          // first, so surfacing later returns somewhere sensible.
          world.jumpTo(clusterEl, zCluster());
          performDive(true);
          return;
        }
        if (prevDived && current.item !== item.id) {
          if (current.cat === cluster.id) {
            // Sibling slide: track order decides the direction —
            // above the current item enters from the left, below
            // from the right. The camera never moves; the hidden
            // dive is retargeted so esc surfaces from the cell we
            // are actually reading.
            const fromIdx = cluster.items.findIndex((entry) => entry.id === current.item);
            const toIdx = cluster.items.indexOf(item);
            const dir = toIdx < fromIdx ? -1 : 1;
            world.diveInto(diveRect(cell), { instant: true });
            track.focal = item.id;
            current = { cat: cluster.id, item: item.id, head: route.head };
            setPath(current);
            slideToPage(item, route.head, dir);
            foldTrackAfter(560);
            return;
          }
          // Different category (manual URL edit): the old bounce.
          suppressSurfaceSync = true;
          closePage();
          world.surface();
          window.setTimeout(() => performDive(false), 430);
          return;
        }
        if (prevDived && current.item === item.id) {
          // Same page, new heading.
          current = { ...current, head: route.head };
          setPath(current);
          if (route.head) {
            scrollMain(route.head, true);
            foldTrackAfter(420);
          }
          return;
        }
        performDive(false);
      }

      window.addEventListener("hashchange", () => applyRoute(parseRoute(), true));

      // Manual surfacing (ctrl-wheel out) drops the item segment.
      world.addEventListener("hp-grid-dive", (event) => {
        const dived = (event as CustomEvent<{ dived: boolean }>).detail.dived;
        if (!dived) {
          if (suppressSurfaceSync) {
            suppressSurfaceSync = false;
            return;
          }
          if (current.item) {
            history.replaceState(null, "", `#/${current.cat}`);
            applyRoute({ cat: current.cat }, false);
          }
        }
      });

      // ── world clicks (cells are real light DOM) ──
      // Claim the press on navigational cells so the grid's
      // pan-passthrough never starts a gesture there — the same
      // pattern hp-unfold-list uses for its source. The cluster's
      // centre is exempt: it is the drag handle.
      world.addEventListener("pointerdown", (event) => {
        if (event.button !== 0) {
          return;
        }
        const target = event.target as HTMLElement | null;
        if (target?.closest(".section, .hx-item")) {
          event.stopPropagation();
        }
      });
      world.addEventListener("click", (event) => {
        const target = event.target as HTMLElement | null;
        if (!target) {
          return;
        }
        const section = target.closest<HTMLElement>(".section");
        if (section?.dataset.cluster) {
          go(`/${section.dataset.cluster}`);
          return;
        }
        if (world.dived) {
          return;
        }
        const item = target.closest<HTMLElement>(".hx-item");
        if (item?.dataset.item && mounted) {
          go(`/${mounted.cluster.id}/${item.dataset.item}`);
          return;
        }
        const centre = target.closest("hp-cluster > hp-cell:first-child");
        if (centre && mounted) {
          world.flyTo(mounted.el, zCluster());
        }
      });
      // Enter activates whatever cell has focus.
      world.addEventListener("keydown", (event) => {
        if (event.key !== "Enter") {
          return;
        }
        const target = event.target as HTMLElement | null;
        if (target?.matches(".section, .hx-item")) {
          target.click();
        }
      });

      // ── the leash: a category drags as one, near its home ──
      const dragOrigins = new Map<HTMLElement, AxialCoord>();
      world.addEventListener("hp-grid-move", (event) => {
        const { element, from } = (
          event as CustomEvent<{ element: HTMLElement; from: AxialCoord }>
        ).detail;
        if (element.tagName.toLowerCase() === "hp-cluster" && !dragOrigins.has(element)) {
          dragOrigins.set(element, from);
        }
      });
      world.addEventListener("hp-grid-drop", (event) => {
        const { element, at } = (
          event as CustomEvent<{ element: HTMLElement; at: AxialCoord }>
        ).detail;
        if (element.tagName.toLowerCase() !== "hp-cluster" || !mounted) {
          return;
        }
        const origin = dragOrigins.get(element);
        dragOrigins.delete(element);
        const home = mounted.cluster.cell!;
        if (axialDistance(at, home) > LEASH_CLUSTER && origin) {
          element.setAttribute("q", String(origin.q));
          element.setAttribute("r", String(origin.r));
          element.classList.add("hx-denied");
          const next = element.nextSibling;
          element.remove();
          world.insertBefore(element, next);
          window.setTimeout(() => element.classList.remove("hx-denied"), 500);
          return;
        }
        clusterOffsets.set(mounted.cluster.id, { q: at.q - home.q, r: at.r - home.r });
      });

      // ── hextrack: sibling hops + anchor sidebar ──
      // The rail stays in focus through whatever a selection causes
      // (the slide, the anchor scroll) and folds when it lands.
      let foldTimer = 0;
      function foldTrackAfter(ms: number): void {
        window.clearTimeout(foldTimer);
        foldTimer = window.setTimeout(() => {
          track.state = "hint";
        }, ms);
      }

      track.addEventListener("hp-hextrack-activate", (event) => {
        const { id } = (event as CustomEvent<HpHextrackActivateDetail>).detail;
        if (!current.cat) {
          return;
        }
        if (id === current.item) {
          track.state = "hint";
          return;
        }
        go(`/${current.cat}/${id}`);
      });
      track.addEventListener("hp-hextrack-sub", (event) => {
        // The event names the item the TRACK is focused on — which
        // may be a sibling, not the open page. Same hex: just scroll.
        // Another hex: the route drives a full deep dive, and
        // performDive carries the heading through to land on it.
        const { id, sub } = (event as CustomEvent<HpHextrackSubDetail>).detail;
        if (current.cat) {
          go(`/${current.cat}/${id}/${slug(sub)}`);
        }
      });

      // ── stage 1: the living seed ──
      let seedHovered = false;
      function syncCalm(): void {
        // The page view always keeps the ambient wake; elsewhere the
        // wake yields to the seed's bloom or the world canvas.
        const calm =
          current.item !== undefined
            ? false
            : seedHovered || seedUnfold.open || current.cat !== undefined;
        bg.classList.toggle("calm", calm);
        bg.classList.toggle("ambient", current.item !== undefined);
      }
      seedCell.addEventListener("pointerenter", () => {
        seedHovered = true;
        dismissHint();
        syncCalm();
      });
      seedCell.addEventListener("pointerleave", () => {
        seedHovered = false;
        syncCalm();
      });
      seedUnfold.addEventListener("hp-unfold-open", () => {
        dismissHint();
        syncCalm();
        syncSectionTabs(true);
        // The bloom needs room: ease the camera back to frame the
        // ring, only when we are sitting at the arrival framing.
        if (!current.cat && !world.dived) {
          world.flyTo({ q: 0, r: 0 }, zBloom());
        }
      });
      seedUnfold.addEventListener("hp-unfold-close", () => {
        syncCalm();
        syncSectionTabs(false);
        if (!current.cat && !world.dived) {
          world.flyTo({ q: 0, r: 0 }, zSeed());
        }
      });
      function syncSectionTabs(open: boolean): void {
        for (const section of document.querySelectorAll<HTMLElement>(".section")) {
          if (open) {
            section.setAttribute("tabindex", "0");
          } else {
            section.removeAttribute("tabindex");
          }
        }
      }
      function dismissHint(): void {
        hintEl.dataset.gone = "";
      }

      // Ambient ignition — alive only while the lone seed is the
      // show, and never on a software compositor.
      window.setInterval(() => {
        if (
          PERF_LOW ||
          current.cat !== undefined ||
          seedUnfold.open ||
          seedHovered ||
          document.visibilityState !== "visible"
        ) {
          return;
        }
        const rect = seedCell.getBoundingClientRect();
        if (rect.width === 0) {
          return;
        }
        bg.ignite(
          rect.left + rect.width * (0.3 + Math.random() * 0.4),
          rect.top + rect.height * (0.3 + Math.random() * 0.4)
        );
      }, 820);

      // The unfold-list's auto drag handle is for travelling lists;
      // the seed is pinned — opt out the documented way.
      seedUnfold.querySelector(':scope > [slot="handle"]')?.remove();

      // ── esc, capture-phase so the overlays keep their own Esc ──
      window.addEventListener(
        "keydown",
        (event) => {
          if (event.key === "Escape") {
            if (!track.hidden && track.state === "focus") {
              return; // hextrack folds itself to hint
            }
            if (current.item) {
              go(`/${current.cat}`);
              return;
            }
            if (current.cat) {
              go("/");
              return;
            }
            // home: the unfold list handles its own Esc (close bloom)
            return;
          }
          const cluster = CLUSTERS.find((c) => c.key === event.key);
          if (cluster && !world.dived) {
            go(`/${cluster.id}`);
          }
          if (event.key === "h" || event.key === "0") {
            go("/");
          }
        },
        { capture: true }
      );

      document.getElementById("hs-reset")!.addEventListener("click", () => {
        clusterOffsets.clear();
        location.hash = "";
        location.reload();
      });

      // ?debug: a live state line, so a stuck frame reports exactly
      // which piece failed instead of needing forensic screenshots.
      if (new URLSearchParams(location.search).has("debug")) {
        const hud = document.createElement("div");
        hud.style.cssText =
          "position:fixed;left:50%;bottom:4px;transform:translateX(-50%);z-index:99;" +
          "font:11px Consolas,monospace;color:#00cc88;background:rgba(20,22,23,.85);" +
          "padding:2px 10px;pointer-events:none;white-space:nowrap;";
        document.body.appendChild(hud);
        window.setInterval(() => {
          hud.textContent =
            `route=${location.hash || "#/"} · open=${page.hasAttribute("data-open")}` +
            ` · pageOp=${getComputedStyle(page).opacity}` +
            ` · dived=${world.dived} · worldVis=${world.style.visibility || "visible"}` +
            ` · worldPE=${world.style.pointerEvents || "auto"} · perf=${PERF_LOW ? "low" : "full"}`;
        }, 250);
      }

      // ── boot: wait for the engine's first frame, read the fan's
      //    shuffle, place categories along those directions, then
      //    restore the route instantly and raise the curtain ──
      function sectionsAssigned(): boolean {
        return [...document.querySelectorAll(".section")].every((s) =>
          s.hasAttribute("data-unfold-index")
        );
      }
      function placeCategories(): void {
        for (const section of document.querySelectorAll<HTMLElement>(".section")) {
          const idx = Number(section.getAttribute("data-unfold-index"));
          const dir = SLOT_DIR[idx] ?? { q: 1, r: 0 };
          const cluster = clusterById(section.dataset.cluster);
          if (cluster) {
            cluster.cell = { q: dir.q * D, r: dir.r * D };
          }
        }
      }
      let engineLive = false;
      world.addEventListener("hp-grid-tier", () => {
        engineLive = true;
      });
      // The curtain must never stay down: if the engine's first
      // frame doesn't arrive (GL failure, throttled tab), reveal the
      // degraded-but-visible page anyway.
      const bootDeadline = performance.now() + 4000;
      function tryBoot(): void {
        if ((!engineLive || !sectionsAssigned()) && performance.now() < bootDeadline) {
          // Timer, not rAF: a hidden tab still has to finish booting.
          window.setTimeout(tryBoot, 120);
          return;
        }
        placeCategories();
        const route = parseRoute();
        if (route.cat) {
          seedUnfold.open = true;
          syncSectionTabs(true);
        }
        applyRoute(route, false);
        stage.classList.add("live");
        stage.dataset.ready = "";
      }
      tryBoot();
    </script>
  </body>
</html>
