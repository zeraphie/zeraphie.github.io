---
/*
  ─ izelya.me — THE JOURNAL (vessel workbench) ─

  A standalone route holding the longform reading vessel while it
  is built out: the full-viewport book — cover, bands, spine, two
  leaves with their stack — with the aetherblade post flowing
  through the multicol page engine as the worst-case content.
  Real metadata, content patterns, the turn animation, and the
  dive integration land here step by step; then the vessel folds
  into the flow and this route retires.
*/
import { getEntry, render } from "astro:content";

import "@hexpunk/core/tokens.dark.css";
import "@hexpunk/core/tokens.light.css";

import "../styles/journal.css";

const title = "the journal · izelya.me";
const description = "The longform reading vessel, under construction.";

const entry = await getEntry("dnd", "aetherblade");
if (!entry) {
  throw new Error("the workbench post is missing");
}
const { Content } = await render(entry);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/fonts/fonts.css" />
  </head>
  <body>
    <main class="journal">
      {
        ["tl", "tr", "bl", "br"].map((corner) => (
          <svg class="journal-corner" data-corner={corner} viewBox="0 0 31 31" aria-hidden="true">
            <path
              class="step"
              d="M 20 0.5 L 30 10.5 L 30 30.5 L 10 30.5 L 0 20.5"
              fill="none"
              stroke-width="1"
            />
            <line class="echo" x1="14" y1="14" x2="21" y2="21" stroke-width="1" />
          </svg>
        ))
      }

      <header class="journal-band journal-band--head">
        <span class="journal-site">izelya.me</span>
        <span class="journal-crumb">// dnd · aetherblade</span>
        <span class="journal-mode">read<i class="journal-dot"></i></span>
      </header>

      <section class="journal-page journal-page--verso" aria-hidden="true"></section>
      <div class="journal-spine" aria-hidden="true"></div>
      <section class="journal-page journal-page--recto" aria-hidden="true"></section>

      <div class="journal-pages" id="journal-pages">
        <aside class="journal-meta">
          <svg
            class="journal-meta-icon"
            width="60"
            height="70"
            viewBox="0 0 60 70"
            aria-hidden="true"
          >
            <polygon
              points="30,2 58,18.5 58,51.5 30,68 2,51.5 2,18.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"></polygon>
          </svg>
          <h1 class="journal-meta-title">Aetherblade</h1>
          <p class="journal-meta-sub">
            A homebrew class themed about inheritance of primordial power
          </p>
          <dl class="journal-meta-stats">
            <dt>Date</dt>
            <dd>2024.09.22</dd>
            <dt>Reading</dt>
            <dd>&approx; 33 min</dd>
            <dt>Words</dt>
            <dd>&approx; 7.3k</dd>
            <dt>Collection</dt>
            <dd>dnd</dd>
            <dt>Status</dt>
            <dd class="live">v0 · wip</dd>
          </dl>
        </aside>
        <div class="journal-prose">
          <Content />
        </div>
      </div>

      <footer class="journal-band journal-band--foot">
        <span class="journal-site">izelya.me</span>
        <svg class="journal-sigil" width="20" height="22" viewBox="0 0 20 22" aria-hidden="true">
          <polygon
            points="10,1.6 19,6.3 19,15.7 10,20.4 1,15.7 1,6.3"
            fill="none"
            stroke="currentColor"
            stroke-width="1"></polygon>
          <circle class="ring" cx="10" cy="11" r="4" fill="none" stroke-width="0.9"></circle>
          <circle cx="10" cy="11" r="1.3" fill="currentColor"></circle>
        </svg>
        <span class="journal-pager">
          <span id="journal-pager-label">page — of —</span>
          <button class="journal-turn" id="journal-turn-prev" type="button" aria-label="previous">
            ‹‹
          </button>
          <span class="arrows">·</span>
          <button class="journal-turn" id="journal-turn-next" type="button" aria-label="next">
            ››
          </button>
        </span>
      </footer>
    </main>

    <script>
      // Reading is turning: the clipped column strip scrolls by whole
      // spreads, never freely. Wheel and keys arm the turn; resize and
      // font arrival re-derive the geometry keeping the leading page.
      const pages = document.getElementById("journal-pages")!;
      const label = document.getElementById("journal-pager-label")!;
      const prev = document.getElementById("journal-turn-prev") as HTMLButtonElement;
      const next = document.getElementById("journal-turn-next") as HTMLButtonElement;

      let perView = 2;
      let unit = 0;
      let count = 1;
      let lead = 0;

      function measure(): void {
        const style = getComputedStyle(pages);
        perView = Math.max(1, Number(style.columnCount) || 1);
        const gap = Number.parseFloat(style.columnGap) || 0;
        const column = (pages.clientWidth - gap * (perView - 1)) / perView;
        unit = column + gap;
        count = Math.max(1, Math.round((pages.scrollWidth + gap) / unit));
      }

      function apply(): void {
        lead = Math.max(0, Math.min(lead, count - 1));
        lead -= lead % perView;
        pages.scrollTo({ left: lead * unit, top: 0, behavior: "instant" });
        const last = Math.min(count, lead + perView);
        label.textContent =
          last > lead + 1
            ? `page ${lead + 1}–${last} of ${count}`
            : `page ${lead + 1} of ${count}`;
        prev.disabled = lead === 0;
        next.disabled = last >= count;
      }

      function turn(dir: number): void {
        lead += dir * perView;
        apply();
      }

      prev.addEventListener("click", () => turn(-1));
      next.addEventListener("click", () => turn(1));

      // One wheel notch is one turn — a cooldown soaks up the tail of
      // inertial deltas so a flick doesn't skip three spreads.
      let wheelAt = 0;
      window.addEventListener(
        "wheel",
        (event) => {
          event.preventDefault();
          const now = performance.now();
          if (now - wheelAt < 320 || Math.abs(event.deltaY) < 4) {
            return;
          }
          wheelAt = now;
          turn(Math.sign(event.deltaY));
        },
        { passive: false }
      );

      window.addEventListener("keydown", (event) => {
        const forward =
          event.key === "ArrowRight" || event.key === "PageDown" ||
          (event.key === " " && !event.shiftKey);
        const back =
          event.key === "ArrowLeft" || event.key === "PageUp" ||
          (event.key === " " && event.shiftKey);
        if (event.key === "Home") {
          lead = 0;
        } else if (event.key === "End") {
          lead = count;
        } else if (forward) {
          lead += perView;
        } else if (back) {
          lead -= perView;
        } else {
          return;
        }
        event.preventDefault();
        apply();
      });

      const refresh = (): void => {
        measure();
        apply();
      };
      new ResizeObserver(refresh).observe(pages);
      window.addEventListener("resize", refresh);
      document.fonts.ready.then(refresh);
      refresh();
    </script>
  </body>
</html>
