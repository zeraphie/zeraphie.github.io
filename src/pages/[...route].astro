---
/**
 * ─ izelya.me — the flow ─
 *
 * The homepage is an hp-grid world, route-driven: arrival is one
 * viewport-filling hex with hp-background ignition; hover blooms
 * the sections (hp-unfold-list); a section flies down a directed
 * hp-tether to its category, a honeycomb hp-cluster; an item opens
 * the journal, where reading is turning. Every state is a real
 * URL; deep links restore instantly.
 */
import { render } from "astro:content";

import "@hexpunk/core/tokens.dark.css";
import "@hexpunk/core/tokens.light.css";
import "@hexpunk/core/elements.css";

import Cartridge from "../components/Cartridge.astro";
import Seo from "../components/Seo.astro";
import { devlogDates } from "../lib/devlog-dates";
import { buildWorld } from "../lib/world";

import "../styles/flow.css";
import "../styles/journal.css";
import "../styles/journal-prose.css";

// The world derives from the content collections: every collection
// with at least one published post becomes a category, its posts the
// items. Every world state is a real page — home, /<collection>, and
// each post at /<collection>/<slug> — all serving this same shell
// with their own title and description for links and crawlers.
export async function getStaticPaths() {
  const { published, clusters } = await buildWorld();
  const entryFor = new Map(published.map((e) => [`${e.collection}/${e.id}`, e]));
  return [
    {
      params: { route: undefined },
      props: {
        title: "izelya.me",
        description: "Izzy's personal site — an hp-grid world of projects, games, and D&D homebrew.",
      },
    },
    {
      params: { route: "sitemap" },
      props: {
        title: "sitemap · izelya.me",
        description: "Every page on izelya.me, by collection.",
      },
    },
    ...clusters.map((c) => ({
      params: { route: c.id },
      props: {
        title: `${c.label} · izelya.me`,
        description: `Everything in the ${c.label} collection on izelya.me.`,
      },
    })),
    ...clusters.flatMap((c) =>
      c.items.map((item) => ({
        params: { route: item.post! },
        props: {
          title: `${item.label} · izelya.me`,
          description: entryFor.get(item.post!)?.data.description ?? `${item.label} on izelya.me`,
          article: {
            section: c.label,
            published: (entryFor.get(item.post!)?.data.date ?? new Date(0)).toISOString(),
          },
        },
      }))
    ),
  ];
}

interface Props {
  title: string;
  description: string;
  article?: { section: string; published: string };
}
const { title, description, article } = Astro.props;

// Backdrop hex side. Deliberately unrelated to the world's own hex
// size: matching them made the ambience read as a second, coarser
// grid competing with the real one. A fine mesh instead, so it sits
// under the content as texture rather than structure.
const BG_HEX_SIDE = 9;

// Published posts render into inert <template>s the reading layer
// clones on dive; their h2s become the hextrack's anchor points,
// shipped to the client as a small JSON index alongside the world.
const { published, clusters } = await buildWorld();
const rendered = await Promise.all(
  published.map(async (entry) => {
    const { Content, headings } = await render(entry);
    const h2s = headings.filter((h) => h.depth === 2);
    // Devlog entries date from the commit that added them, so the
    // dates are read out of git rather than out of the frontmatter.
    const logged = devlogDates(entry.filePath ?? `src/content/${entry.collection}/${entry.id}.md`);
    return {
      key: `${entry.collection}/${entry.id}`,
      Content,
      meta: {
        title: entry.data.title,
        description: entry.data.description,
        icon: entry.data.icon ?? null,
        logo: entry.data.logo ?? null,
        game: entry.data.game ?? null,
        date: entry.data.date.toISOString().slice(0, 10),
        words: (entry.body ?? "").split(/\s+/).filter(Boolean).length,
        anchors: h2s.map((h, i) => ({
          head: h.slug,
          label: h.text,
          date: logged.get(i) ?? null,
        })),
      },
    };
  })
);
const postIndex = Object.fromEntries(rendered.map(({ key, meta }) => [key, meta]));

// Slim pages: only this route's post ships inline — every other
// post's content is fetched (and prefetched) from its own page.
const currentPost = rendered.find((r) => r.key === Astro.params.route) ?? null;
const CurrentContent = currentPost?.Content;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} article={article} />
    <link rel="stylesheet" href="/fonts/fonts.css" />
  </head>
  <body>
    <hp-background id="bg" page hex-size={String(BG_HEX_SIDE)}></hp-background>

    <div id="hs-stage">
      <hp-grid id="world" draggable>
        <hp-unfold-list id="seed-unfold" unordered hover q="0" r="0" draggable="false">
          <hp-cell variant="anchor" filled slot="source" id="seed-cell">
            <span class="seed-mark">
              izelya
              <hp-pixel id="seed-invader" pixel-size="4"></hp-pixel>
            </span>
          </hp-cell>
          {
            clusters.map((cluster) => (
              <hp-cell class="section" data-cluster={cluster.id} variant="action">
                {cluster.label}
              </hp-cell>
            ))
          }
          <hp-cell class="section" data-cluster="sitemap" variant="action">sitemap</hp-cell>
        </hp-unfold-list>
      </hp-grid>

      <button type="button" class="hs-back" id="hs-back" hidden>‹ back</button>

      <!-- The dived page: the world fades beneath this layer and
           reading happens in the journal. The reading layer fills
           the metadata panel and the flow strip per post. -->
      <div class="page" id="page">
        <main class="journal" data-turns="static">
          {
            ["tl", "tr", "bl", "br"].map((corner) => (
              <svg
                class="journal-corner"
                data-corner={corner}
                viewBox="0 0 31 31"
                aria-hidden="true"
              >
                <path
                  class="step"
                  d="M 20 0.5 L 30 10.5 L 30 30.5 L 10 30.5 L 0 20.5"
                  fill="none"
                  stroke-width="1"
                />
                <line class="echo" x1="14" y1="14" x2="21" y2="21" stroke-width="1" />
              </svg>
            ))
          }

          <header class="journal-band journal-band--head">
            <a class="journal-site" href="/">izelya.me</a>
            <i class="journal-sigil" aria-hidden="true"></i>
            <span class="journal-crumb"></span>
          </header>

          <div class="journal-body">
            <section class="journal-page journal-page--verso" aria-hidden="true"></section>
            <div class="journal-spine" aria-hidden="true"></div>
            <section class="journal-page journal-page--recto" aria-hidden="true"></section>

            <div class="journal-pages" id="journal-pages">
              <aside class="journal-meta">
                <svg
                  class="journal-meta-icon"
                  width="60"
                  height="70"
                  viewBox="0 0 60 70"
                  aria-hidden="true"
                >
                  <polygon
                    points="30,2 58,18.5 58,51.5 30,68 2,51.5 2,18.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.4"></polygon>
                  <g class="journal-meta-glyph" transform="translate(18 23)"></g>
                </svg>
                <h2 class="journal-meta-title"></h2>
                <p class="journal-meta-sub"></p>
                <hr class="hp-separator" data-mark="dot" aria-hidden="true" />
                <dl class="journal-meta-stats">
                  <dt>Date</dt>
                  <dd data-stat="date"></dd>
                  <dt>Time</dt>
                  <dd data-stat="time"></dd>
                </dl>
              </aside>
              <div class="journal-prose"></div>
            </div>
          </div>

          <footer class="journal-band journal-band--foot">
            <span class="journal-site">izelya.me</span>
            <i class="journal-sigil" aria-hidden="true"></i>
            <span class="journal-pager">
              <span id="journal-pager-label">page — of —</span>
              <button
                class="journal-turn"
                id="journal-turn-prev"
                type="button"
                aria-label="previous"
              >
                ‹‹
              </button>
              <span class="arrows">·</span>
              <button class="journal-turn" id="journal-turn-next" type="button" aria-label="next">
                ››
              </button>
            </span>
          </footer>
        </main>
      </div>

      <hp-hextrack id="track" loop hidden></hp-hextrack>

      <!-- The lost toast: when a pan settles with no hexes on
           screen, the site's mark shows up over the grid with a way
           back. The WHOLE thing is the button — hovering anywhere
           morphs the bubble, clicking anywhere centers. -->
      <div class="lost-veil" id="lost-veil" hidden></div>
      <button type="button" class="lost-toast" id="lost-toast" aria-label="Take me back" hidden>
        <span class="lost-mark" aria-hidden="true">
          <i class="lost-invader" id="lost-invader"></i>
          <i class="lost-star"></i>
          <i class="lost-star"></i>
          <i class="lost-star"></i>
        </span>
        <span class="lost-bubble">
          <span class="lost-rest">
            <span class="lost-line">hey, noticed you might be lost</span>
            <span class="lost-sub">wanna go back?</span>
          </span>
          <span class="lost-act">
            <svg
              viewBox="0 0 24 24"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 7V5a2 2 0 0 1 2-2h2"></path>
              <path d="M17 3h2a2 2 0 0 1 2 2v2"></path>
              <path d="M21 17v2a2 2 0 0 1-2 2h-2"></path>
              <path d="M7 21H5a2 2 0 0 1-2-2v-2"></path>
            </svg>
            take me back
          </span>
        </span>
      </button>
    </div>

    <div id="posts" hidden>
      {
        currentPost && CurrentContent && (
          <template data-post={currentPost.key}>
            {
              currentPost.meta.game && (
                <Cartridge
                  href={currentPost.meta.game}
                  title={currentPost.meta.title}
                  icon={currentPost.meta.icon}
                  logo={currentPost.meta.logo}
                  collection={currentPost.key.split("/")[0]!}
                  date={currentPost.meta.date}
                  words={currentPost.meta.words}
                  description={currentPost.meta.description}
                />
              )
            }
            <CurrentContent />
          </template>
        )
      }
    </div>
    <script
      is:inline
      type="application/json"
      id="post-index"
      set:html={JSON.stringify(postIndex).replaceAll("<", "\\u003c")}
    />
    <script
      is:inline
      type="application/json"
      id="world-index"
      set:html={JSON.stringify(clusters).replaceAll("<", "\u003c")}
    />



    <script>
      import "@hexpunk/core";
      import "@hexpunk/core/wip";
      import {
        axialToWorld,
        hexHeight,
        hexWidth,
        seamlessSide,
        type AxialCoord,
        type HpGrid,
      } from "@hexpunk/core/grid";
      import type { HpBackground, HpPixel, HpPixelPosition } from "@hexpunk/core";
      import type {
        HpHextrack,
        HpHextrackActivateDetail,
        HpHextrackSubDetail,
        HpUnfoldList,
      } from "@hexpunk/core/wip";

      import { itemPath, type Cluster, type Item } from "../lib/flow-data";
      import { createClusterLayer } from "../lib/flow/clusters";
      import { prefetchPosts } from "../lib/flow/content-cache";
      import { initPerfMode, installDebugHud } from "../lib/flow/perf";
      import { anchorsOf, slug } from "../lib/flow/posts";
      import { createReadingLayer, type JournalDoc } from "../lib/flow/reading";
      import { createRouter, type Route } from "../lib/flow/router";
      import { INVADER_HOVER, INVADER_IDLE } from "../lib/site-logo";

const PERF_LOW = initPerfMode();

      /** The world, as the build derived it from the collections. */
      const CLUSTERS = JSON.parse(
        document.getElementById("world-index")!.textContent!
      ) as Cluster[];
      const { clusterById, parseRoute, routePath } = createRouter(CLUSTERS);

      const PAD = 64;
      /** How long the sections ignore input after the ring blooms —
       * long enough to swallow the opening tap's own click. */
      const BLOOM_GUARD = 420;
      let bloomedAt = 0;
      /** Category distance from the seed along its fan direction —
       * far enough that fully-expanded neighbours never touch. */
      const D = 14;
      const LEASH_CLUSTER = 3;

      const stage = document.getElementById("hs-stage")!;
      const world = document.getElementById("world") as HpGrid;
      const bg = document.getElementById("bg") as HpBackground;
      /* The invader under the wordmark. States are a property, not an
         attribute, so it is wired here; `state` is deliberately left
         unset, because setting it pins --hp-pixel-shadow INLINE and
         inline style would beat the hover rule in flow.css. The cell's
         label is pointer-events:none, so the pixel can never be
         hovered itself — the swap has to key off the cell. */
      const invader = document.getElementById("seed-invader") as HpPixel | null;
      if (invader) {
        invader.states = { idle: INVADER_IDLE, hover: INVADER_HOVER };
      }
      const track = document.getElementById("track") as HpHextrack;
      const seedUnfold = document.getElementById("seed-unfold") as HpUnfoldList;
      const seedCell = document.getElementById("seed-cell")!;

      let bloomGuardTimer = 0;
      /** A touch opens the bloom by hover and then delivers a click
       * from the same gesture — which would land on whichever section
       * just arrived under the finger. Deafen them until the ring has
       * settled. */
      function armBloomGuard(): void {
        bloomedAt = performance.now();
        stage.dataset.blooming = "";
        window.clearTimeout(bloomGuardTimer);
        bloomGuardTimer = window.setTimeout(() => {
          delete stage.dataset.blooming;
        }, BLOOM_GUARD);
      }

      const backEl = document.getElementById("hs-back") as HTMLButtonElement;

      const side = seamlessSide(100, 2.5);
      const cellW = hexWidth(side);
      const cellH = hexHeight(side);

      /* hp-unfold-list's ring slots, by data-unfold-index. */
      const SLOT_DIR: AxialCoord[] = [
        { q: 0, r: -1 },
        { q: 1, r: -1 },
        { q: 1, r: 0 },
        { q: 0, r: 1 },
        { q: -1, r: 1 },
        { q: -1, r: 0 },
      ];
      /* hp-cluster honeycomb fill order, centre first. */
      const HONEY: AxialCoord[] = [
        { q: 0, r: 0 },
        { q: 0, r: -1 },
        { q: 1, r: -1 },
        { q: 1, r: 0 },
        { q: 0, r: 1 },
        { q: -1, r: 1 },
        { q: -1, r: 0 },
        { q: 0, r: -2 },
        { q: 1, r: -2 },
      ];


      const axialDistance = (a: AxialCoord, b: AxialCoord): number => {
        const dq = a.q - b.q;
        const dr = a.r - b.r;
        return (Math.abs(dq) + Math.abs(dr) + Math.abs(dq + dr)) / 2;
      };

      // ── framing math (viewport-derived each time) ──
      const vw = () => stage.clientWidth;
      const vh = () => stage.clientHeight;
      /** Framing inset scales with the smaller axis: a fixed 64px
       * eats a third of a phone's width. */
      const pad = () => Math.min(PAD, Math.round(Math.min(vw(), vh()) * 0.09));
      /** Fit a world extent to BOTH axes. Height alone was enough
       * while every screen was landscape; on a narrow one it frames
       * a view that overflows sideways. */
      const fit = (w: number, h: number) =>
        Math.min((vw() - 2 * pad()) / w, (vh() - 2 * pad()) / h);
      /** Arrival: the lone seed, sat a little short of filling the
       * frame so the bloom is a short move away. */
      const zSeed = () => fit(cellW, cellH) * 0.78;
      /** Bloomed: the seed and its ring — 3 cells across, 5 sides
       * tall. */
      const zBloom = () => fit(3 * cellW, cellH + 3 * side);
      /** A category cluster (ring 2): 5 cells across, 8 sides tall. */
      const zCluster = () => fit(5 * cellW, cellH + 6 * side);

// ── the dived page layer ──
      const page = document.getElementById("page")!;
      let current: Route = {};
      const reading = createReadingLayer({
        page,
        world,
        bg,
        perfLow: PERF_LOW,
        isCurrentHead: (head) => current.head === head,
        // Every heading on screen reads as current in the rail —
        // the pages decide, the rail paints.
        onAnchorsVisible: (indexes) => {
          track.currentSubs = indexes;
        },
      });

const clusters = createClusterLayer(world);

      /** The rail spans the WHOLE world, not one collection: with a
       * handful of posts per collection a single-cluster list is too
       * short to scrub, so every published post rides it and the
       * track loops. Rows key on the post path — slugs can repeat
       * across collections, paths cannot. */
      function railItems() {
        return CLUSTERS.flatMap((cluster) =>
          cluster.items
            .filter((entry) => !entry.ghost)
            .map((entry) => ({
              id: entry.post ?? entry.id,
              label: entry.label,
              sub: cluster.label,
              subs: anchorsOf(entry).map((a) => a.label),
            }))
        );
      }
      function itemByKey(key: string): { cluster: Cluster; item: Item } | null {
        for (const cluster of CLUSTERS) {
          const item = cluster.items.find((entry) => (entry.post ?? entry.id) === key);
          if (item) {
            return { cluster, item };
          }
        }
        return null;
      }

      /** The sitemap is the world written out: every collection and
       * every post it holds, as ordinary links. */
      function buildSitemap(): JournalDoc {
        const esc = (s: string) => s.replaceAll("&", "&amp;").replaceAll("<", "&lt;");
        const list = CLUSTERS.map((cluster) => {
          const items = cluster.items
            .filter((item) => !item.ghost)
            .map((item) => `<li><a href="${itemPath(item)}">${esc(item.label)}</a></li>`)
            .join("");
          return `<li><h2 id="${cluster.id}"><a href="/${cluster.id}">${esc(cluster.label)}</a></h2><ul>${items}</ul></li>`;
        }).join("");
        return {
          id: "sitemap",
          title: "Sitemap",
          description: "Every page on izelya.me, by collection",
          icon: "map",
          html: `<p>A useful collection of links for this site.</p>
            <hr class="hp-separator" aria-hidden="true" />
            <ul class="journal-sitemap"><li><a href="/">home</a></li>${list}</ul>`,
        };
      }

      // ── router: the hash is the state ──
      function go(path: string): void {
        if (location.pathname + location.hash === path) {
          return;
        }
        history.pushState(null, "", path);
        applyRoute(parseRoute(), true);
      }
      let suppressSurfaceSync = false;


      /** Back exists whenever there is a level to leave: a post, a
       * category, or the bloom itself. */
      function syncBack(): void {
        backEl.hidden = !current.cat && !current.doc && !seedUnfold.open;
      }

      /** Fly the camera back to the route's focus: the mounted
       * category cluster, or the seed at home. A no-op while the
       * journal covers the world. */
      function centerOnRoute(): void {
        if (world.dived) {
          return;
        }
        if (current.cat && clusters.mounted) {
          world.flyTo(clusters.mounted.el, zCluster());
          return;
        }
        world.flyTo({ q: 0, r: 0 }, seedUnfold.open ? zBloom() : zSeed());
      }

      /** The center chip's tooltip names the route focus. The value
       * is a quoted string because CSS `content` consumes it. */
      function syncCenterTip(): void {
        const label = current.cat ? (clusterById(current.cat)?.label ?? current.cat) : "home";
        world.style.setProperty("--world-center-tip", JSON.stringify(`CENTER · ${label.toUpperCase()}`));
      }

      // The chrome's recenter flies home; this site centers on the
      // route's focus instead. A capturing listener claims the click
      // before the shadow handler runs — the `part` attribute is the
      // contract.
      world.addEventListener(
        "click",
        (event) => {
          const hit = event
            .composedPath()
            .find((node) => node instanceof Element && node.getAttribute("part") === "recenter");
          if (hit) {
            event.stopPropagation();
            centerOnRoute();
          }
        },
        { capture: true }
      );

      function setPath(route: Route): void {
        syncBack();
        syncCenterTip();
        // The journal covers the stage: no toast may float over it.
        if (route.item || route.doc) {
          lostDismissForRoute();
        }
        const item = clusterById(route.cat)?.items.find((entry) => entry.id === route.item);
        document.title = item
          ? `${item.label} · izelya.me`
          : route.cat
            ? `${route.cat} · izelya.me`
            : "izelya.me";
      }

      /** Dive framing that fits the whole hex on screen: the engine
       * fits a rect's WIDTH, so hand it an effective width whose fit
       * lands the zoom at (viewport height − padding) / hex height.
       * On viewports too narrow for that, the real width wins. */
      function diveRect(cell: HTMLElement): { cx: number; cy: number; w: number; h: number } {
        const slot = Number(cell.dataset.slot);
        const el = clusters.mounted!.el;
        const q = Number(el.getAttribute("q")) + (HONEY[slot]?.q ?? 0);
        const r = Number(el.getAttribute("r")) + (HONEY[slot]?.r ?? 0);
        const [cx, cy] = axialToWorld(q, r, side);
        const zFit = (vh() - 2 * 24) / cellH;
        const wEff = (stage.clientWidth * 0.94) / zFit;
        return { cx, cy, w: Math.max(cellW, wEff), h: cellH };
      }


      function applyRoute(route: Route, animated: boolean): void {
        const cluster = clusterById(route.cat);
        const prevDived = world.dived;

        // page + hextrack bookkeeping first
        if ((!route.item || route.doc) && current.item) {
          reading.close();
          track.state = "hint";
          track.hidden = true;
        }

        if (route.doc === "sitemap") {
          // A standalone document: the world stays where it is
          // behind the vessel, so leaving returns to it.
          clusters.unmount(animated);
          current = { doc: "sitemap" };
          setPath(current);
          syncCalm();
          reading.openDoc(buildSitemap());
          return;
        }
        if (current.doc) {
          reading.close();
        }

        if (!cluster) {
          // home
          clusters.unmount(animated);
          if (prevDived) {
            suppressSurfaceSync = true;
            world.surface();
          }
          const zoom = seedUnfold.open ? zBloom() : zSeed();
          if (animated) {
            world.flyTo({ q: 0, r: 0 }, zoom);
          } else {
            world.jumpTo({ q: 0, r: 0 }, zoom);
          }
          current = {};
          setPath(current);
          syncCalm();
          return;
        }

        // a category is in view — the fan is part of that view
        seedUnfold.open = true;
        clusters.mount(cluster, animated && !prevDived);
        const clusterEl = clusters.mounted!.el;

        if (!route.item) {
          if (prevDived) {
            suppressSurfaceSync = true;
            world.surface();
          }
          if (animated) {
            world.flyTo(clusterEl, zCluster());
          } else {
            world.jumpTo(clusterEl, zCluster());
          }
          current = { cat: cluster.id };
          setPath(current);
          syncCalm();
          return;
        }

        const item = cluster.items.find((entry) => entry.id === route.item && !entry.ghost);
        if (!item) {
          go(`/${cluster.id}`);
          return;
        }
        const cell = clusterEl.querySelector<HTMLElement>(`[data-item="${item.id}"]`)!;

        // Opening a post is instant: the camera is placed, not flown.
        // The journal fills the viewport, so a flight beneath it is
        // invisible — and the world's hover/relight kept surfacing
        // through the fade.
        const performDive = () => {
          prefetchPosts(cluster.items.map((entry) => entry.post));
          // The world goes pointer-dead the moment the dive starts:
          // nothing beneath the incoming page may hover or re-light.
          world.style.pointerEvents = "none";
          world.diveInto(diveRect(cell), { instant: true });
          track.items = railItems();
          track.focal = item.post ?? item.id;
          track.state = "hint";
          track.hidden = false;
          current = { cat: cluster.id, item: item.id, head: route.head };
          setPath(current);
          syncCalm();
          reading.open(item, route.head, true);
        };

        if (!animated) {
          // Deep link: place the pre-dive camera at the category view
          // first, so surfacing later returns somewhere sensible.
          world.jumpTo(clusterEl, zCluster());
          performDive();
          return;
        }
        if (prevDived && current.item !== item.id) {
          // The rail crosses collections, so a sibling and a
          // cross-collection hop are the same move: retarget the
          // hidden dive and swap the book.
          performDive();
          return;
        }
        if (prevDived && current.item === item.id) {
          // Same page, new heading.
          current = { ...current, head: route.head };
          setPath(current);
          if (route.head) {
            reading.scrollTo(route.head, true);
            foldTrackAfter(420);
          }
          return;
        }
        performDive();
      }

      window.addEventListener("popstate", () => applyRoute(parseRoute(), true));

      // Manual surfacing (ctrl-wheel out) drops the item segment.
      world.addEventListener("hp-grid-dive", (event) => {
        const dived = (event as CustomEvent<{ dived: boolean }>).detail.dived;
        if (!dived) {
          if (suppressSurfaceSync) {
            suppressSurfaceSync = false;
            return;
          }
          if (current.item) {
            history.replaceState(null, "", `/${current.cat}`);
            applyRoute({ cat: current.cat }, false);
          }
        }
      });

      // ── world clicks (cells are real light DOM) ──
      // Claim the press on navigational cells so the grid's
      // pan-passthrough never starts a gesture there — the same
      // pattern hp-unfold-list uses for its source. The cluster's
      // centre is exempt: it is the drag handle.
      world.addEventListener("pointerdown", (event) => {
        if (event.button !== 0) {
          return;
        }
        const target = event.target as HTMLElement | null;
        if (target?.closest(".section, .hx-item")) {
          event.stopPropagation();
        }
      });
      world.addEventListener("click", (event) => {
        const target = event.target as HTMLElement | null;
        if (!target) {
          return;
        }
        const section = target.closest<HTMLElement>(".section");
        if (section?.dataset.cluster) {
          if (performance.now() - bloomedAt < BLOOM_GUARD) {
            return;
          }
          go(`/${section.dataset.cluster}`);
          return;
        }
        if (world.dived) {
          return;
        }
        const item = target.closest<HTMLElement>(".hx-item");
        if (item?.dataset.item && clusters.mounted) {
          const entry = clusters.mounted.cluster.items.find((e) => e.id === item.dataset.item);
          if (entry) {
            go(itemPath(entry));
          }
          return;
        }
        const centre = target.closest("hp-cluster > hp-cell:first-child");
        if (centre && clusters.mounted) {
          world.flyTo(clusters.mounted.el, zCluster());
        }
      });
      // Enter activates whatever cell has focus.
      world.addEventListener("keydown", (event) => {
        if (event.key !== "Enter") {
          return;
        }
        const target = event.target as HTMLElement | null;
        if (target?.matches(".section, .hx-item")) {
          target.click();
        }
      });

      // ── the leash: a category drags as one, near its home ──
      const dragOrigins = new Map<HTMLElement, AxialCoord>();
      world.addEventListener("hp-grid-move", (event) => {
        const { element, from } = (
          event as CustomEvent<{ element: HTMLElement; from: AxialCoord }>
        ).detail;
        if (element.tagName.toLowerCase() === "hp-cluster" && !dragOrigins.has(element)) {
          dragOrigins.set(element, from);
        }
      });
      world.addEventListener("hp-grid-drop", (event) => {
        const { element, at } = (
          event as CustomEvent<{ element: HTMLElement; at: AxialCoord }>
        ).detail;
        if (element.tagName.toLowerCase() !== "hp-cluster" || !clusters.mounted) {
          return;
        }
        const origin = dragOrigins.get(element);
        dragOrigins.delete(element);
        const home = clusters.mounted.cluster.cell!;
        if (axialDistance(at, home) > LEASH_CLUSTER && origin) {
          element.setAttribute("q", String(origin.q));
          element.setAttribute("r", String(origin.r));
          element.classList.add("hx-denied");
          const next = element.nextSibling;
          element.remove();
          world.insertBefore(element, next);
          window.setTimeout(() => element.classList.remove("hx-denied"), 500);
          return;
        }
        clusters.offsets.set(clusters.mounted.cluster.id, { q: at.q - home.q, r: at.r - home.r });
      });

      // ── hextrack: sibling hops + anchor sidebar ──
      // The rail stays in focus through whatever a selection causes
      // (the slide, the anchor scroll) and folds when it lands.
      let foldTimer = 0;
      function foldTrackAfter(ms: number): void {
        window.clearTimeout(foldTimer);
        foldTimer = window.setTimeout(() => {
          track.state = "hint";
        }, ms);
      }

      track.addEventListener("hp-hextrack-activate", (event) => {
        const { id } = (event as CustomEvent<HpHextrackActivateDetail>).detail;
        if (!current.cat) {
          return;
        }
        if (itemByKey(id)?.item.id === current.item) {
          track.state = "hint";
          return;
        }
        const found = itemByKey(id);
        if (found) {
          go(itemPath(found.item));
        }
      });
      track.addEventListener("hp-hextrack-sub", (event) => {
        // The event names the item the TRACK is focused on — which
        // may be a sibling, not the open page. Same hex: just scroll.
        // Another hex: the route drives a full deep dive, and
        // performDive carries the heading through to land on it.
        const { id, sub } = (event as CustomEvent<HpHextrackSubDetail>).detail;
        if (!current.cat) {
          return;
        }
        const owner = itemByKey(id)?.item;
        if (!owner) {
          return;
        }
        const head = anchorsOf(owner).find((a) => a.label === sub)?.head ?? slug(sub);
        go(`${itemPath(owner)}#${head}`);
      });

      // ── the seed ──
      let seedHovered = false;
      function syncCalm(): void {
        // The page view always keeps the ambient wake; elsewhere the
        // wake yields to the seed's bloom or the world canvas.
        const calm =
          current.item !== undefined
            ? false
            : seedHovered || seedUnfold.open || current.cat !== undefined;
        bg.classList.toggle("calm", calm);
        bg.classList.toggle("ambient", current.item !== undefined);
      }
      seedCell.addEventListener("pointerenter", () => {
        seedHovered = true;
        // Arm the guard at the START of the gesture, not when the
        // ring reports itself open: a quick tap can deliver its
        // click before that event lands.
        if (!seedUnfold.open) {
          armBloomGuard();
        }
        syncCalm();
      });
      seedCell.addEventListener("pointerleave", () => {
        seedHovered = false;
        syncCalm();
      });
      seedUnfold.addEventListener("hp-unfold-open", () => {
        armBloomGuard();
        // The bloom is intent: warm every published post so any dive
        // that follows reads from cache, never the network.
        prefetchPosts(CLUSTERS.flatMap((c) => c.items.map((entry) => entry.post)));
        syncCalm();
        syncSectionTabs(true);
        // The bloom needs room: ease the camera back to frame the
        // ring, only when we are sitting at the arrival framing.
        syncBack();
        if (!current.cat && !world.dived) {
          world.flyTo({ q: 0, r: 0 }, zBloom());
        }
      });
      seedUnfold.addEventListener("hp-unfold-close", () => {
        syncCalm();
        syncSectionTabs(false);
        syncBack();
        if (!current.cat && !world.dived) {
          world.flyTo({ q: 0, r: 0 }, zSeed());
        }
      });
      function syncSectionTabs(open: boolean): void {
        for (const section of document.querySelectorAll<HTMLElement>(".section")) {
          if (open) {
            section.setAttribute("tabindex", "0");
          } else {
            section.removeAttribute("tabindex");
          }
        }
      }

      // Ambient ignition — only while the lone seed is on show, and
      // never on a software compositor.
      window.setInterval(() => {
        if (
          PERF_LOW ||
          current.cat !== undefined ||
          seedUnfold.open ||
          seedHovered ||
          document.visibilityState !== "visible"
        ) {
          return;
        }
        const rect = seedCell.getBoundingClientRect();
        if (rect.width === 0) {
          return;
        }
        bg.ignite(
          rect.left + rect.width * (0.3 + Math.random() * 0.4),
          rect.top + rect.height * (0.3 + Math.random() * 0.4)
        );
      }, 820);

      // The unfold-list's auto drag handle is for travelling lists;
      // the seed is pinned — opt out the documented way.
      seedUnfold.querySelector(':scope > [slot="handle"]')?.remove();

      // ── esc, capture-phase so the overlays keep their own Esc ──
      window.addEventListener(
        "keydown",
        (event) => {
          if (event.key === "Escape") {
            if (!track.hidden && track.state === "focus") {
              return; // hextrack folds itself to hint
            }
            if (current.item) {
              go(`/${current.cat}`);
              return;
            }
            if (current.cat) {
              go("/");
              return;
            }
            // home: the unfold list handles its own Esc (close bloom)
            return;
          }
          const cluster = CLUSTERS.find((c) => c.key === event.key);
          if (cluster && !world.dived) {
            go(`/${cluster.id}`);
          }
          if (event.key === "h" || event.key === "0") {
            go("/");
          }
        },
        { capture: true }
      );

      // Back walks the world up one level: post → category → home.
      // The press is swallowed before it reaches the grid — its pan
      // handling would otherwise capture the pointer and eat the
      // click.
      backEl.addEventListener("pointerdown", (event) => event.stopPropagation());
      backEl.addEventListener("click", () => {
        if (current.doc) {
          go("/");
        } else if (current.item) {
          go(`/${current.cat}`);
        } else if (current.cat) {
          go("/");
        } else {
          // Home, bloomed: fold the sections back to the lone seed.
          seedUnfold.open = false;
        }
      });

      // ── the lost toast: the mark notices an empty viewport ──
      const lostToast = document.getElementById("lost-toast")!;
      const lostVeil = document.getElementById("lost-veil")!;
      const lostInvader = document.getElementById("lost-invader")!;

      // The sprite's two real poses as shadow lists at toast scale —
      // the same constants the seed cell wires into hp-pixel.
      const LOST_SCALE = 4;
      const poseShadow = (pose: HpPixelPosition[]): string =>
        pose.map(([x, y]) => `${x * LOST_SCALE}px ${y * LOST_SCALE}px 0 0 currentColor`).join(", ");
      lostInvader.style.boxShadow = poseShadow(INVADER_IDLE);
      if (!PERF_LOW && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        lostInvader.animate(
          [{ boxShadow: poseShadow(INVADER_IDLE) }, { boxShadow: poseShadow(INVADER_HOVER) }],
          { duration: 1600, direction: "alternate", iterations: Infinity, easing: "ease-in-out" }
        );
      }

      /** Does any world content intersect the viewport? The seed and
       * the mounted cluster are the world's only occupants. */
      function worldContentVisible(): boolean {
        const margin = 40;
        const w = stage.clientWidth;
        const h = stage.clientHeight;
        const rects = [seedCell.getBoundingClientRect(), clusters.mounted?.el.getBoundingClientRect()];
        return rects.some(
          (r) =>
            r !== undefined &&
            r.width > 0 &&
            r.right > -margin &&
            r.left < w + margin &&
            r.bottom > -margin &&
            r.top < h + margin
        );
      }

      let lostTimer = 0;
      /** Once per drift: a dismissed toast stays away until hexes
       * come back into frame. */
      let lostShown = false;
      function lostHide(): void {
        lostToast.hidden = true;
        lostVeil.hidden = true;
      }
      /** Route change into the journal ends the drift outright. */
      function lostDismissForRoute(): void {
        lostShown = false;
        lostHide();
      }
      /** The debounced landing: the pan stopped — if it stopped on
       * emptiness, the mark shows up. */
      function lostSettle(): void {
        lostTimer = 0;
        if (world.dived || document.visibilityState !== "visible" || worldContentVisible()) {
          return;
        }
        if (!lostShown) {
          lostShown = true;
          lostToast.hidden = false;
          lostVeil.hidden = false;
        }
      }
      // Every pan event restarts the 0.5s debounce; hexes coming
      // back into frame end the drift immediately.
      world.addEventListener("hp-grid-pan", () => {
        if (world.dived) {
          return;
        }
        window.clearTimeout(lostTimer);
        lostTimer = 0;
        if (worldContentVisible()) {
          lostShown = false;
          if (!lostToast.hidden) {
            lostHide();
          }
          return;
        }
        lostTimer = window.setTimeout(lostSettle, 500);
      });

      // Clicking anywhere on it centers; a press anywhere else
      // dismisses it for this drift.
      lostToast.addEventListener("click", () => {
        lostHide();
        centerOnRoute();
      });
      stage.addEventListener("pointerdown", (event) => {
        if (!lostToast.hidden && !lostToast.contains(event.target as Node)) {
          lostHide();
        }
      });

      installDebugHud(
        () =>
          `route=${location.pathname}${location.hash} · open=${page.hasAttribute("data-open")}` +
          ` · pageOp=${getComputedStyle(page).opacity}` +
          ` · dived=${world.dived} · worldVis=${world.style.visibility || "visible"}` +
          ` · worldPE=${world.style.pointerEvents || "auto"} · perf=${PERF_LOW ? "low" : "full"}`
      );

      // ── boot: wait for the engine's first frame, read the fan's
      //    slot assignments, place categories along those
      //    directions, then restore the route and reveal ──
      function sectionsAssigned(): boolean {
        return [...document.querySelectorAll(".section")].every((s) =>
          s.hasAttribute("data-unfold-index")
        );
      }
      function placeCategories(): void {
        for (const section of document.querySelectorAll<HTMLElement>(".section")) {
          const idx = Number(section.getAttribute("data-unfold-index"));
          const dir = SLOT_DIR[idx] ?? { q: 1, r: 0 };
          const cluster = clusterById(section.dataset.cluster);
          if (cluster) {
            cluster.cell = { q: dir.q * D, r: dir.r * D };
          }
        }
      }
      let engineLive = false;
      world.addEventListener("hp-grid-tier", () => {
        engineLive = true;
      });
      // The curtain must never stay down: if the engine's first
      // frame doesn't arrive (GL failure, throttled tab), reveal the
      // degraded-but-visible page anyway.
      const bootDeadline = performance.now() + 4000;
      function tryBoot(): void {
        if ((!engineLive || !sectionsAssigned()) && performance.now() < bootDeadline) {
          // Timer, not rAF: a hidden tab still has to finish booting.
          window.setTimeout(tryBoot, 120);
          return;
        }
        placeCategories();
        const route = parseRoute();
        if (route.cat) {
          seedUnfold.open = true;
          syncSectionTabs(true);
        }
        applyRoute(route, false);
        stage.classList.add("live");
        stage.dataset.ready = "";
      }
      tryBoot();
    </script>
  </body>
</html>
